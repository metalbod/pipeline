# Local object storage stand-in (see ingestion/object_store.py)
OBJECT_STORE_BACKEND=file
OBJECT_STORE_ROOT=./storage

# DuckDB warehouse file used by dbt (profiles.yml) and Dagster
DUCKDB_PATH=./storage/warehouse.duckdb

# Xero API connector (MY-PARENT). Get client id/secret from your Xero Developer app.
# Run `python scripts/xero_oauth_bootstrap.py` once to obtain the initial refresh token
# (written to XERO_TOKEN_FILE, not stored in env -- Xero rotates it on every use).
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_TENANT_ID=
XERO_TOKEN_FILE=.secrets/xero_token.json

# Superset (ops/superset/docker-compose.yml). Generate real values for anything beyond local dev
# -- SUPERSET_SECRET_KEY should be a long random string (e.g. `openssl rand -base64 42`).
SUPERSET_SECRET_KEY=
SUPERSET_DB_PASSWORD=
SUPERSET_ADMIN_PASSWORD=
SUPERSET_BASE_URL=http://localhost:8088
SUPERSET_ADMIN_USERNAME=admin

# Email alerting (Phase 3): data-quality failures and late file arrivals.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=kenneth.yong@mandrill.com.my

# OpenMetadata (ops/openmetadata/docker-compose.yml)
OPENMETADATA_BASE_URL=http://localhost:8585/api
OPENMETADATA_JWT_TOKEN=
DBT_TARGET_DIR=./dbt_project/target
